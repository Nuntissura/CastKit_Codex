{
  "name": "castkit-codex",
  "version": "0.2.10",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "dev:renderer": "vite --port 5173",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "npm run dev:renderer",
    "electron:dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "vite build --emptyOutDir --outDir ../CKC_GOV/targets/scratch/renderer-dist",
    "preview": "vite preview --outDir ../CKC_GOV/targets/scratch/renderer-dist",
    "test": "node --test",
    "package:win:raw": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package_win.ps1",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump patch",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump patch",
    "package:mac:raw": "bash scripts/package_mac.sh",
    "package:mac": "bash scripts/release_mac.sh --bump patch",
    "release:mac": "bash scripts/release_mac.sh --bump patch",
    "electron:build": "npm run package:win"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "js-yaml": "^4.1.1",
    "pg": "^8.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sqlite3": "^5.1.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.2.2",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "tar": "7.5.7"
  },
  "build": {
    "appId": "com.nuntissura.castkitcodex",
    "productName": "CastKit-Codex",
    "directories": {
      "output": "../CKC_GOV/targets/CKC/artifacts"
    },
    "files": [
      "app/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "scripts/installer_custom.nsh"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
